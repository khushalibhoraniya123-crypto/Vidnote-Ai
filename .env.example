# VidNote AI - Environment Configuration Example

# Django Secret Key (generate a unique string for production)
SECRET_KEY=django-insecure-change-this-in-production-secret-key

# Debug Mode (Set to True for development, False for production)
DEBUG=True

# Allowed Hosts (comma-separated without spaces)
ALLOWED_HOSTS=127.0.0.1,localhost

# Optional: Path to custom FFmpeg binary (Leave empty to use auto-detected or bundled binary)
FFMPEG_PATH=

# Whisper Speech-to-Text Model (tiny, base, small, medium, large-v3)
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# AI & LLM Provider Configuration (gemini, openai, groq, or fallback)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Optional: Custom Model Name override (e.g. gemini-2.5-flash, gpt-4o-mini, llama-3.3-70b-versatile)
LLM_MODEL_NAME=
